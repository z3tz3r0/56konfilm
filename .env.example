# --- 🟢 PUBLIC CONFIGURATION (Prefix with NEXT_PUBLIC_) ---
# These are exposed to the browser.
NEXT_PUBLIC_SANITY_PROJECT_ID="project_id"
NEXT_PUBLIC_SANITY_DATASET="production" # production | development
NEXT_PUBLIC_SANITY_API_VERSION="2025-08-12"
# NEXT_PUBLIC_SITE_URL=
DEFAULT_SITE_MODE="production" # production | wedding

# --- 🔵 SANITY CMS CONFIGURATION (Server-side) ---
SANITY_API_TOKEN="at_least_32_characters_long"
SANITY_REVALIDATE_SECRET="at_least_32_characters_long"
SANITY_CMS_SESSION_SECRET="at_least_32_characters_long"
SANITY_CMS_SESSION_MAX_AGE=604800
SANITY_CMS_REMEMBER_MAX_AGE=2592000

# --- CONTACT EMAIL (Server-side) ---
# Keep disabled until Resend and the Phase 2 spam safeguards are configured.
# With false, the contact form cannot submit; the three values below may be blank.
# With true, all three values are required and validated during startup/build.
CONTACT_EMAIL_ENABLED=false
# RESEND_API_KEY=
# Use a verified sender-domain email address (address only, no display name).
# CONTACT_EMAIL_FROM=
# The owner's single destination address; a personal Gmail address is allowed.
# CONTACT_EMAIL_TO=

# --- 🔴 TESTING & E2E CONFIGURATION ---
# Used for Playwright or Cypress tests.
# BASE_URL= # For overriding site base URL when testing
TEST_USER_EMAIL="test@example.com"
# TEST_USER_PASSWORD=
# TEST_ENV=
